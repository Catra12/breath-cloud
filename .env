# ==================================================
# BREATH AI CLOUD - CẤU HÌNH GỬI EMAIL CẢNH BÁO TÉ NGÃ
# Hướng dẫn Gmail:
# 1. Bật xác thực 2 bước cho tài khoản Google của bạn
# 2. Truy cập: https://myaccount.google.com/apppasswords
# 3. Tạo "Mật khẩu ứng dụng" (App Password) gồm 16 chữ cái (ví dụ: abcd efgh ijkl mnop)
# 4. Điền EMAIL_SENDER và EMAIL_PASSWORD (dán 16 chữ cái không có khoảng trắng)
# ==================================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
ALERT_RECEIVER_EMAIL=
ENABLE_EMAIL_ALERT=true
